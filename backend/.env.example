# --- local storage ---
STUDIO_DATA=/home/you/shahnameh-studio/data

# --- image generation ---
# flux_gateway = the GPU box gateway (/v1/generate) | openai_images = any OpenAI-compatible images API
IMAGE_PROVIDER=flux_gateway
FLUX_API_BASE=http://YOUR_GPU_HOST:8090
OPENAI_IMAGE_BASE=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
# mask-based inpainting service (Flux edit API)
IMAGE_EDIT_BASE=http://YOUR_GPU_HOST:8092

# --- video generation (OpenAI Videos / Sora-style) ---
VIDEO_PROVIDER=ltx_openai
VIDEO_API_BASE=http://YOUR_GPU_HOST:8091

# --- speech ---
# piper (local) | openai (any /v1/audio/speech) | fish (Fish Speech server)
TTS_PROVIDER=piper
PIPER_VOICE=fa_IR-amir-medium
TTS_MODEL=gpt-audio-1.5

# --- llm (script writing, scene compile) ---
LLM_BASE=https://api.avalai.ir/v1
LLM_MODEL=deepseek-v4.1-flash
AVALAI_KEY=

# --- ffmpeg (static build) ---
FFMPEG_BIN=/path/to/studio/bin/ffmpeg
